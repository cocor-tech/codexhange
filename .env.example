# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/codexhange

# Admin auth
ADMIN_SEED_EMAIL=admin@codexhange.com
ADMIN_SEED_PASSWORD=your-strong-password-here
NEXTAUTH_SECRET=your-random-64-char-secret

# Admin OTP email (Brevo)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=noreply@codexhange.com

# Bot
CONCURRENCY=15
PLAYWRIGHT=false

# AI enrichment (optional — free tier)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.0-flash

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
